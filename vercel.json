{
  "crons": [
    { "path": "/api/cron/check-expirations", "schedule": "0 3 * * *" }
  ],
  "functions": {
    "api/cron/check-expirations.js": {
      "includeFiles": "app-shell.html"
    },
    "api/pages/home.js": {
      "includeFiles": "app-shell.html"
    },
    "api/pages/users.js": {
      "includeFiles": "users-shell.html"
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/pages/home" },
    { "source": "/users.html", "destination": "/api/pages/users" }
  ]
}
