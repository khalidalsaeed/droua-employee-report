GMAIL_USER=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password
CRON_SECRET=optional_random_secret_to_protect_the_cron_endpoint
SESSION_SECRET=long_random_string_used_to_sign_login_sessions
# وجهة تنبيه إنشاء مسير الرواتب الشهري (بريد + إشعار دفع إلى أجهزة صاحبه).
# القيمة الاحتياطية إن لم يُضبط: hr-manager@droua.com
PAYROLL_NOTIFY_EMAIL=hr-manager@droua.com

# ─── الحساب المحميّ (Protected User) ───────────────────────────────────
# قائمة معرّفات users.id مفصولة بفواصل. أيّ حساب مذكور هنا لا تستطيع أدوات
# إدارة المستخدمين المساس ببريده أو دوره أو حالته أو صلاحياته أو كلمة مروره
# — مهما كان دور من يحاول، ولو كان مالكًا. وصاحب الحساب وحده يغيّر اسمه أو
# كلمة مروره، والأخيرة بتقديم كلمة المرور الحالية.
#
# غياب المتغيّر أو تركه فارغًا = لا حساب محميّ = سلوك المنصّة كما هو تمامًا.
# لا تضع هنا معرّفًا حقيقيًا: القيمة الحقيقية تُضبط في متغيّرات بيئة Vercel
# على الإنتاج وحده، ولا تدخل المستودع.
PROTECTED_USER_IDS=00000000-0000-0000-0000-000000000000

# ─── بوابة قسم المراجعة السرّي (/secure-audit) ──────────────────────────
# غياب أيّ من الأربعة الأولى — أو تلف صيغة الهاش — يُخفي القسم كلَّه بـ404
# لكل مستخدم بلا استثناء. لا قيمة حقيقية هنا: الحقيقية تُضبط في متغيّرات
# بيئة Vercel (Production فقط، مع Sensitive) ولا تدخل المستودع.

# معرّف users.id المصرَّح له. يجب أن يكون مذكورًا في PROTECTED_USER_IDS
# أيضًا: حمايةُ حسابٍ وحدها لا تمنح وصولًا، ونزعُ الحماية يقفل القسم.
DROUA_AUDIT_USER_IDS=00000000-0000-0000-0000-000000000000
# البريد المتوقَّع — الشرط الثاني للهوية.
DROUA_AUDIT_EMAILS=you@example.com
# سرّ توقيع جلسة البوابة. يجب أن يختلف عن SESSION_SECRET: تسريب أحدهما
# يجب ألّا يفتح الآخر.  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DROUA_GATE_SECRET=replace_with_32_bytes_of_randomness_hex
# هاش كلمة مرور البوابة — لا كلمة المرور نفسها. يُولَّد على جهازك:
#   node scripts/hash-gate-password.js
# الصيغة: scrypt$<log2N>$<r>$<p>$<salt-hex>$<hash-hex>
DROUA_AUDIT_GATE_PASSWORD_HASH=scrypt$17$8$1$<salt>$<hash>
# فلفل يُدمج قبل الاشتقاق، فالهاش المسرَّب وحده لا يُهاجَم offline.
# ⚠️ فقدانه أو تغييره يُبطل الهاش القائم ولو كانت كلمة المرور صحيحة.
DROUA_AUDIT_GATE_PEPPER=replace_with_32_bytes_of_randomness_hex

# ─── وحدة مقارنة التأمين الطبي (/secure-benefits) ─────────────────────
# غياب أيّ من الثلاثة الأولى أو تلفها يُخفي الوحدة كلّها بـ404. لا قيمة حقيقية
# هنا: الحقيقية في متغيّرات بيئة Vercel (Production فقط، مع Sensitive).
# فحص الأسماء محليًّا بلا طباعة قيم:  node scripts/check-medins-config.js
#
# ⚠️ الأعضاء وأدوارهم ليسوا هنا: صفوفٌ في medins_members تُدار بـ
#    node scripts/medins-members.js  — بلا إعادة نشر. والعضو يجب أن يكون
#    ضمن PROTECTED_USER_IDS أعلاه.

# سرّ توقيع جلسة البوابة. يجب أن يختلف عن SESSION_SECRET و DROUA_GATE_SECRET.
MEDINS_GATE_SECRET=replace_with_32_bytes_of_randomness_hex
# فلفل كلمات مرور البوابة (لكل عضو هاشه في القاعدة). إلزاميّ هنا، ومختلف عن غيره.
# ⚠️ تغييره يُبطل كل كلمات مرور البوابة القائمة.
MEDINS_GATE_PEPPER=replace_with_32_bytes_of_randomness_hex
# اختياريّان: مهلة الخمول (5–60، افتراضي 15) والسقف المطلق (15–480، افتراضي 60) بالدقائق.
# MEDINS_GATE_IDLE_MINUTES=15
# MEDINS_GATE_ABSOLUTE_MINUTES=60

# متجر Blob **خاصّ** مستقلّ للوحدة. يجب ألّا يساوي توكن متجر أجير ولا توكن Droua.
MEDINS_BLOB_READ_WRITE_TOKEN=vercel_blob_rw_replace_me
# حلقة مفاتيح تشفير الملفّات: متغيّر لكل مفتاح، ولا مادّة مشتركة مع DROUA_FILE_KEY_*.
MEDINS_FILE_ACTIVE_KEY_ID=k1
MEDINS_FILE_KEY_K1=replace_with_64_hex_chars
