GMAIL_USER=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password
CRON_SECRET=optional_random_secret_to_protect_the_cron_endpoint
SESSION_SECRET=long_random_string_used_to_sign_login_sessions
# وجهة تنبيه إنشاء مسير الرواتب الشهري (بريد + إشعار دفع إلى أجهزة صاحبه).
# القيمة الاحتياطية إن لم يُضبط: hr-manager@droua.com
PAYROLL_NOTIFY_EMAIL=hr-manager@droua.com

# ─── الحساب المحميّ (Protected User) ───────────────────────────────────
# قائمة معرّفات users.id مفصولة بفواصل. أيّ حساب مذكور هنا لا تستطيع أدوات
# إدارة المستخدمين المساس ببريده أو دوره أو حالته أو صلاحياته أو كلمة مروره
# — مهما كان دور من يحاول، ولو كان مالكًا. وصاحب الحساب وحده يغيّر اسمه أو
# كلمة مروره، والأخيرة بتقديم كلمة المرور الحالية.
#
# غياب المتغيّر أو تركه فارغًا = لا حساب محميّ = سلوك المنصّة كما هو تمامًا.
# لا تضع هنا معرّفًا حقيقيًا: القيمة الحقيقية تُضبط في متغيّرات بيئة Vercel
# على الإنتاج وحده، ولا تدخل المستودع.
PROTECTED_USER_IDS=00000000-0000-0000-0000-000000000000
